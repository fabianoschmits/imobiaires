{
  "outputDirectory": "site",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:slug((?!js/|painel|imobiliaria|favicon|index|base\\.css|style\\.css|painel\\.css).*)",
      "destination": "/imobiliaria.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}

